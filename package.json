{
  "name": "wheeler-universe-blog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite-ssg build",
    "build:clean": "npm run prettier:write && npm run lint && npm run test && npm run build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "lint": "eslint .",
    "lint:check": "eslint .",
    "lint:write": "eslint . --fix",
    "prettier": "prettier --check src/",
    "prettier:check": "prettier --check src/",
    "prettier:write": "prettier --write src/"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@unhead/vue": "^2.0.12",
    "vite-ssg": "^28.0.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-vue": "^4.5.2",
    "@vitest/ui": "^3.2.4",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "^9.19.2",
    "happy-dom": "^18.0.1",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "prettier-plugin-organize-imports": "^3.2.3",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.10"
  }
}
